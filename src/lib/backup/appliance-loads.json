{
  "version": 1,
  "as_of": "2026-09-25",
  "description": "Typical household appliance loads for the Porchlight 'must stay on' component. Every value is an estimate; users can edit watts. The component sums kwh_per_day of switched-on items (times quantity for per_unit items) and divides by 24 to get average load in kW.",
  "units": {
    "circuit_v": "volts",
    "running_w": "watts [min, max] while running",
    "surge_w": "watts [min, max] at motor start, null if negligible",
    "kwh_per_day": "typical energy per day during an outage (per unit when per_unit is true)",
    "kwh_per_day_range": "[low, high] when use varies a lot, else null"
  },
  "groups": [
    {
      "id": "always_on",
      "label": "Always on"
    },
    {
      "id": "essentials",
      "label": "Essentials"
    },
    {
      "id": "kitchen",
      "label": "Kitchen"
    },
    {
      "id": "heating_cooling",
      "label": "Heating and cooling"
    },
    {
      "id": "water_laundry",
      "label": "Water, laundry and pool"
    },
    {
      "id": "pumps_other",
      "label": "Pumps and other"
    }
  ],
  "battery": {
    "kwh_per_core": 39.2,
    "kw_per_core_spec": 20,
    "power_limit_kw_help_center": {
      "one_battery": 11,
      "two_batteries": 22
    },
    "reserve_fraction": null,
    "efficiency": null,
    "open_questions": [
      "Power limit: 11 kW (help center) vs 20 kW per Core (spec)",
      "Reserve kept at the start of an unforeseen outage",
      "Inverter efficiency"
    ]
  },
  "formula": {
    "usable_kwh": "kwh_per_core * cores * (start_charge - reserve_fraction) * efficiency",
    "load_kw": "sum(kwh_per_day * quantity for switched-on items) / 24",
    "hours_left": "usable_kwh / load_kw",
    "power_ok": "sum(running_w max * quantity) + max(surge_w max) <= power limit"
  },
